    "@nuxtjs/toast": "^3.3.1",
    "@onlyoffice/document-editor-vue": "^1.6.0",
    "@pdftron/webviewer": "^11.7.1",
    "@pinia-plugin-persistedstate/nuxt": "^1.2.1",
