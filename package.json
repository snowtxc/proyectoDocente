{
  "name": "nuxt-ui-pro-template-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run copy-webviewer && nuxt build",
    "dev": "npm run copy-webviewer && nuxt dev",
    "generate": "npm run copy-webviewer && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "copy-webviewer": "mkdir -p ./public/lib/webviewer && cp -a ./node_modules/@pdftron/webviewer/public/* ./public/lib/webviewer"
  },
